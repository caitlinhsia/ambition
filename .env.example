# Optional. Without this, budg3 works entirely from its built-in rules and
# makes no network calls at all.
#
# With it set, naming a wall sends just that text to Groq to be broken into
# bricks. Nothing else is ever sent — no habits, journal, or history.
#
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile. Change if that model is
# retired or you want a faster/cheaper one.
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Optional. Without these, accounts and data stay in this browser's storage
# and never leave the device. With them, an account is real and follows you
# between phone and laptop.
#
# Unlike GROQ_API_KEY above, these two are meant to be public — the anon key
# grants nothing by itself, because every read and write is checked by
# row-level security in Postgres (see supabase/schema.sql). Never put a
# Supabase service_role key in a NEXT_PUBLIC_ variable, or in this app at all.
#
# From your project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
