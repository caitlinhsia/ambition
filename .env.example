# Optional. Without this, budg3 works entirely from its built-in rules and
# makes no network calls at all.
#
# With it set, naming a wall sends just that text to Groq to be broken into
# bricks. Nothing else is ever sent — no habits, journal, or history.
#
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile. Change if that model is
# retired or you want a faster/cheaper one.
# GROQ_MODEL=llama-3.3-70b-versatile
